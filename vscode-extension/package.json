{
  "name": "uds-lsp-extension",
  "displayName": "UDS LSP",
  "description": "Language support for UDS bundle definitions and referenced YAML values files.",
  "publisher": "defenseunicorns",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/defenseunicorns/uds-cli.git",
    "directory": "vscode-extension"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:hcl",
    "onLanguage:yaml",
    "workspaceContains:**/{bundle,defaults,config}.uds.hcl"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "uds-lsp-extension.restartServer",
        "title": "UDS LSP: Restart Server"
      }
    ],
    "languages": [
      {
        "id": "hcl",
        "aliases": ["HCL", "hcl"],
        "extensions": [".hcl"]
      }
    ],
    "configuration": {
      "title": "UDS LSP",
      "properties": {
        "udsLsp.serverPath": {
          "type": "string",
          "default": "uds-lsp",
          "description": "Executable name on PATH or an absolute path to uds-lsp. Shell and VS Code variables are not expanded. Reload the window after changing this setting."
        },
        "udsLsp.serverArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Arguments for the UDS language server, which must communicate over stdin/stdout. Reload the window after changing this setting."
        },
        "udsLsp.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "LSP protocol trace verbosity. With vscode-languageclient 10, also set the UDS LSP output channel log level to Trace."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "vsce package --no-dependencies --baseContentUrl https://github.com/defenseunicorns/uds-cli/blob/HEAD/vscode-extension/ --out ../build/uds-lsp-extension.vsix",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  }
}
